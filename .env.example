# تمام تنظیمات از متغیرهای محیطی خوانده می‌شوند.
# این فایل را به .env کپی کن و پر کن. هرگز .env را کامیت نکن.

# ── ضروری ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@Bio_with_AI

# ── اختیاری ──────────────────────────────────────────────────────────────
# گزارش خطاها به این چت می‌رود (آیدی عددی خودت، مثلاً 123456789)
ADMIN_CHAT_ID=

# اختیاری: کلید رایگان NCBI. سقف PubMed را از ۳ به ۱۰ درخواست/ثانیه می‌برد.
# https://ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# مدل‌ها. فهرست زنده: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.7-flash
IMAGE_MODEL=gemini-3.1-flash-image

# امضای پایانی پست‌ها
CHANNEL_SIGNATURE=@Bio_with_AI

# مسیر فایل حافظه
STATE_PATH=state/memory.json

# کلیدهای رفتاری
DRY_RUN=false
SKIP_IMAGES=false
SKIP_SIGNALS=false

# تنظیم دقیق‌تر
TEMPERATURE=0.9
MAX_OUTPUT_TOKENS=4096
MAX_RETRIES=3
REQUEST_TIMEOUT=180
