# تمام تنظیمات از متغیرهای محیطی خوانده می‌شوند.
# این فایل را به .env کپی کن و پر کن. هرگز .env را کامیت نکن.

# ── ضروری ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional: additional authorized keys, comma/newline separated
GEMINI_API_KEYS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@Bio_with_AI

# ── اختیاری ──────────────────────────────────────────────────────────────
# گزارش خطاها به این چت می‌رود (آیدی عددی خودت، مثلاً 123456789)
ADMIN_CHAT_ID=

# اختیاری: کلید رایگان NCBI. سقف PubMed را از ۳ به ۱۰ درخواست/ثانیه می‌برد.
# https://ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# مدل متن (این بات تصویر تولید نمی‌کند؛ خروجی کانال فقط متن است).
# فهرست زنده: https://ai.google.dev/gemini-api/docs/models
# نکته: فهرست مدل‌های واقعیِ *اکانت خودت* ممکن است فرق کند. برای دیدنش در تب
# Actions ورکفلوی diagnose را اجرا کن.
# ⚠️ سری Gemini 3 روی لایهٔ رایگان سهمیه ندارد (همیشه 429).
# خانوادهٔ ۲.۵ هنوز رایگان کار می‌کند، پس پیش‌فرض همان است.
GEMINI_MODEL=gemini-2.5-flash

# نردبان جایگزین (با کاما جدا کن). سهمیهٔ هر مدل جداست، پس وقتی مدل اول 429
# داد، *درجا و بدون صبر* مدل بعدی امتحان می‌شود. ترتیب = ترتیب اولویت.
# خالی بگذاری، فهرست پیش‌فرض داخل config.py استفاده می‌شود.
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-flash-latest,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.7-flash

# اگر true بگذاری، مدل‌های Pro *اول* امتحان می‌شوند و به‌محض تمام شدن سهمیه
# درجا به Flash/Lite می‌افتند. پیش‌فرض false است چون سهمیهٔ رایگان Pro کم است.
GEMINI_PREFER_PRO=false

# امضای پایانی پست‌ها
CHANNEL_SIGNATURE=@Bio_with_AI

# مسیر فایل حافظه
STATE_PATH=state/memory.json

# کلیدهای رفتاری
DRY_RUN=false
SKIP_SIGNALS=false

# تنظیم دقیق‌تر
TEMPERATURE=0.9
# مدل‌های ۲.۵ توکن «فکر» هم از این بودجه مصرف می‌کنند؛ کمش نگذار.
MAX_OUTPUT_TOKENS=8192
MAX_RETRIES=3
REQUEST_TIMEOUT=180
